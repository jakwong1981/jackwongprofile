{
  "name": "jackwong-profile-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Public profile site and administrative dashboard for the personal profile management system",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
