# frontend/.env.example
# Base URL of the Spring Boot service as seen from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Base URL used during server-side rendering. Inside Docker Compose this is the
# service name, e.g. http://backend:8080. Falls back to NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_BASE_URL=http://localhost:8080
