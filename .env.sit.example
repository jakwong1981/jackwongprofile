# Jack Wong Profile System - SIT Environment Variables
# Copy this file to .env.sit and modify values as needed

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MySQL Database
DB_HOST=db
DB_PORT=3306
DB_NAME=profile_db
DB_USER=profile_user
DB_PASSWORD=ProfilePass123!
DB_ROOT_PASSWORD=RootPass123!

# ============================================
# BACKEND CONFIGURATION (Spring Boot)
# ============================================

# Spring Profiles
SPRING_PROFILES_ACTIVE=docker

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# JWT Authentication
JWT_SECRET=YourJwtSecretKeyHereChangeInProduction
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ============================================
# FRONTEND CONFIGURATION (Next.js)
# ============================================

# API Configuration
# For browser access - use localhost
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# For server-side rendering inside Docker - use backend hostname
API_INTERNAL_BASE_URL=http://backend:8080/api/v1
NEXT_PUBLIC_APP_NAME="Jack Wong Profile"
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION="Personal profile management system with AI news aggregation"

# Feature Flags
NEXT_PUBLIC_ENABLE_I18N=true
NEXT_PUBLIC_ENABLE_NEWS=true
NEXT_PUBLIC_ENABLE_ADMIN=true

# ============================================
# DEEPSEEK API INTEGRATION
# ============================================

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=2000

# ============================================
# NEWS AGGREGATOR CONFIGURATION
# ============================================

# News Sources (enable/disable)
NEWS_RUNDOWN_AI_ENABLED=true
NEWS_TECHCRUNCH_AI_ENABLED=true
NEWS_MIT_TECH_REVIEW_ENABLED=true
NEWS_DEEPLEARNING_AI_ENABLED=true
NEWS_HUGGINGFACE_ENABLED=true

# Ingestion Schedule (cron expression)
NEWS_INGESTION_SCHEDULE="0 */6 * * *"  # Every 6 hours

# Rate Limiting
NEWS_FETCH_DELAY_MS=2000
NEWS_MAX_CONCURRENT_FETCHES=3
NEWS_REQUEST_TIMEOUT_MS=10000

# Analysis Configuration
NEWS_ANALYSIS_ENABLED=true
NEWS_ANALYSIS_BATCH_SIZE=10
NEWS_ANALYSIS_CONCURRENT_LIMIT=5

# ============================================
# APPLICATION SETTINGS
# ============================================

# Profile Settings
PROFILE_SLUG=jack-wong
PROFILE_PUBLISHED=true

# Admin Settings
ADMIN_USERNAME=system-admin
ADMIN_PASSWORD=SecureAdminPass2024!
ADMIN_DISPLAY_NAME=Administrator
ADMIN_EMAIL=admin@example.com

# Internationalization
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,zhHans,zhHant
FALLBACK_LOCALE=en

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_COM_JACKWONG_PROFILE=DEBUG
LOG_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOG_LEVEL_ORG_HIBERNATE=WARN

# Log Format
LOG_FORMAT=json
LOG_PATTERN=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n

# ============================================
# MONITORING & METRICS
# ============================================

# Spring Boot Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# ============================================
# SECURITY CONFIGURATION
# ============================================

# Rate Limiting
RATE_LIMIT_PUBLIC=100  # requests per minute
RATE_LIMIT_ADMIN=1000  # requests per minute
RATE_LIMIT_NEWS_INGESTION=1  # requests per 5 minutes

# Session Management
SESSION_TIMEOUT_MINUTES=30
REMEMBER_ME_VALIDITY_SECONDS=2592000  # 30 days

# ============================================
# FILE STORAGE (Future Use)
# ============================================

# File Upload
FILE_UPLOAD_MAX_SIZE=10MB
FILE_UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx
FILE_STORAGE_PATH=/uploads

# ============================================
# EMAIL CONFIGURATION (Future Use)
# ============================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@jackwongprofile.com

# ============================================
# PERFORMANCE SETTINGS
# ============================================

# Database Connection Pool
DB_CONNECTION_POOL_MIN_SIZE=5
DB_CONNECTION_POOL_MAX_SIZE=20
DB_CONNECTION_TIMEOUT_MS=30000

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_MINUTES=30
CACHE_MAX_SIZE=1000

# ============================================
# DEBUGGING & DEVELOPMENT
# ============================================

# Development Flags
DEBUG_ENABLED=false
SHOW_SQL=false
SHOW_SQL_PARAMETERS=false

# Testing Configuration
TEST_MODE=false
TEST_DATA_ENABLED=true

# ============================================
# NOTES
# ============================================

# IMPORTANT SECURITY NOTES:
# 1. Change all passwords before production use
# 2. Use strong JWT secrets (min 32 characters)
# 3. Configure proper SSL/TLS certificates
# 4. Set up firewall rules
# 5. Regular database backups

# DeepSeek API Key:
# - Get your API key from https://platform.deepseek.com/
# - Store it securely, never commit to version control
# - Use environment variables or secret management

# Database:
# - Change default passwords (RootPass123!, ProfilePass123!)
# - Configure proper user permissions
# - Enable encryption for sensitive data

# Next Steps:
# 1. Copy this file to .env.sit
# 2. Update values with your configuration
# 3. Run ./scripts/deploy-sit.sh
# 4. Access application at http://localhost:3000